#!/usr/bin/env bash
# dev — repo-local convenience wrapper (bash, per sw_dev_handbook, pinned v0.10.0).
#
# Commands:
#   ./dev bootstrap       Install/refresh local dev-only setup (currently: the
#                         shared commit-msg hook). Safe to re-run any time.
#   ./dev test            Run the test suite alone (tests/*_test.sh).
#   ./dev build           No-op: this is a single Bash script with no compile
#                         step. Present to satisfy sw_dev_handbook's minimum
#                         ./dev subcommand set.
#   ./dev ci              Run every gate CI runs: bash -n, shellcheck, shfmt -d,
#                         actionlint (if any workflows), smoke test, tests.
#   ./dev fmt             Apply shfmt formatting in place.
#   ./dev lint            Run shellcheck alone.
#   ./dev handbook-check  Run sw_dev_handbook's conformance checker.
#
# Missing tools hard-fail with install hints (v0.6.0 pattern).
set -euo pipefail
cd "$(dirname "$0")"

shell_scripts=(
  unifiwifioptimizer
  dev
  scripts/install.sh
  scripts/uninstall.sh
  scripts/sync-commit-msg-hook.sh
  scripts/github-security-settings.sh
  scripts/handbook-check.sh
)
for f in tests/*_test.sh; do
  [[ -f "$f" ]] && shell_scripts+=("$f")
done

require() {
  local tool=$1 hint=$2
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "$tool not found — install: $hint" >&2
    exit 1
  fi
}

run_bash_syntax() {
  for f in "${shell_scripts[@]}"; do
    [[ -f "$f" ]] || continue
    bash -n "$f"
  done
}

run_shellcheck() {
  require shellcheck "brew install shellcheck (macOS) / apt-get install shellcheck (Debian)"
  local present=()
  for f in "${shell_scripts[@]}"; do
    [[ -f "$f" ]] && present+=("$f")
  done
  shellcheck -x "${present[@]}"
}

run_shfmt_diff() {
  require shfmt "go install mvdan.cc/sh/v3/cmd/shfmt@v3.13.1"
  local present=()
  for f in "${shell_scripts[@]}"; do
    [[ -f "$f" ]] && present+=("$f")
  done
  shfmt -d "${present[@]}"
}

run_shfmt_write() {
  require shfmt "go install mvdan.cc/sh/v3/cmd/shfmt@v3.13.1"
  local present=()
  for f in "${shell_scripts[@]}"; do
    [[ -f "$f" ]] && present+=("$f")
  done
  shfmt -w "${present[@]}"
}

run_actionlint() {
  if ! compgen -G ".github/workflows/*.yml" >/dev/null; then
    return 0
  fi
  require actionlint "go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12"
  actionlint
}

run_smoke() {
  ./unifiwifioptimizer --help >/dev/null
}

run_tests() {
  local f
  for f in tests/*_test.sh; do
    [[ -f "$f" ]] || continue
    bash "$f"
  done
}

run_bootstrap() {
  if [[ -x scripts/sync-commit-msg-hook.sh ]]; then
    ./scripts/sync-commit-msg-hook.sh
  fi
}

run_build() {
  echo "nothing to build -- single bash script, no compile step"
}

run_handbook_check() {
  require yq "brew install yq (macOS) -- must be mikefarah/yq v4, not kislyuk/yq"
  ./scripts/handbook-check.sh
}

cmd="${1:-}"
case "$cmd" in
bootstrap)
  run_bootstrap
  ;;
test)
  run_tests
  ;;
build)
  run_build
  ;;
ci)
  run_bash_syntax
  run_shellcheck
  run_shfmt_diff
  run_actionlint
  run_smoke
  run_tests
  echo "dev ci: OK"
  ;;
fmt)
  run_shfmt_write
  ;;
lint)
  run_shellcheck
  ;;
handbook-check)
  run_handbook_check
  ;;
*)
  echo "usage: ./dev {bootstrap|test|build|ci|fmt|lint|handbook-check}"
  exit 1
  ;;
esac
